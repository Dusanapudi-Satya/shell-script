#!/bin/bash
R="\e[31m"
G="\e[32m"
Y="\e[33m"
N="\e[0m"
# step 1: check if the directory exists or not

SOURCE_DIR=/tmp/shellscript-logs
if[ ! -d $SOURCE_DIR ]
then
    echo -e "$R Source Directory does not exists $N"
fi
FILES_TO_DELETE= $(find . -type f -mtime +14 -name "*.log")
while IFS read -r line
do
    echo "Deleting $line"
done <<< FILES_TO_DELETE
